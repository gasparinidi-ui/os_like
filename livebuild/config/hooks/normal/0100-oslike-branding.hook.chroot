#!/bin/sh
# Identidade visual e nome do sistema.
set -e

cat > /etc/os-release <<'OSR'
PRETTY_NAME="OSLike 1.0 (base Debian 13)"
NAME="OSLike"
VERSION_ID="1.0"
VERSION="1.0"
VERSION_CODENAME=trixie
ID=oslike
ID_LIKE=debian
HOME_URL="https://github.com/gasparinidi-ui/os_like"
SUPPORT_URL="https://github.com/gasparinidi-ui/os_like/issues"
BUG_REPORT_URL="https://github.com/gasparinidi-ui/os_like/issues"
OSR

printf 'OSLike 1.0 \\n \\l\n' > /etc/issue
echo "OSLike 1.0" > /etc/issue.net
echo "oslike" > /etc/hostname

# Tema de boot
if command -v plymouth-set-default-theme >/dev/null 2>&1; then
	plymouth-set-default-theme breeze || true
fi

# Cache de ícones (ícone do menu Iniciar)
if command -v gtk-update-icon-cache >/dev/null 2>&1; then
	gtk-update-icon-cache -f /usr/share/icons/hicolor || true
fi

chmod +x /usr/local/bin/oslike-firstrun /usr/share/oslike/desktop-icons/*.desktop /usr/share/oslike/instalar-oslike.desktop

# Atalho do instalador (calamares-install-debian.desktop no Debian 13):
# renomeia o item do menu para o nome do OSLike.
find / -xdev -name '*install-debian.desktop' -type f 2>/dev/null | while read -r f; do
	sed -i -e '/^Name\[/d' -e '/^GenericName/d' -e '/^Comment\[/d' \
		-e 's/^Name=.*/Name=Instalar OSLike/' \
		-e 's/^Comment=.*/Comment=Instala o OSLike no disco/' "$f"
	echo "Atalho do instalador renomeado: $f"
done

# O atalho próprio do OSLike usa o mesmo comando do atalho do Debian
DEB_DESKTOP=/usr/share/applications/calamares-install-debian.desktop
OSL_DESKTOP=/usr/share/oslike/instalar-oslike.desktop
if [ -f "$DEB_DESKTOP" ]; then
	DEB_EXEC="$(grep -m1 '^Exec=' "$DEB_DESKTOP" || true)"
	if [ -n "$DEB_EXEC" ]; then
		grep -v '^Exec=' "$OSL_DESKTOP" > "$OSL_DESKTOP.tmp"
		echo "$DEB_EXEC" >> "$OSL_DESKTOP.tmp"
		mv "$OSL_DESKTOP.tmp" "$OSL_DESKTOP"
		chmod 0755 "$OSL_DESKTOP"
		echo "Atalho Instalar OSLike: $DEB_EXEC"
	fi
fi
